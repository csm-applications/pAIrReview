@ARTICLE{Chen2026,
	author = {Chen, Xilin and null, null and Xiao, Feng and Huang, Mengqi and Zhang, Qianbing},
	title = {Sustainability of underground infrastructure – Part 3: TunCO2, an open-source digital toolbox for accounting and optimising decarbonisation in tunnelling},
	year = {2026},
	journal = {Tunnelling and Underground Space Technology},
	volume = {167},
	pages = {},
	doi = {10.1016/j.tust.2025.107028},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014498581&doi=10.1016%2Fj.tust.2025.107028&partnerID=40&md5=3eeab8971c82397ed48f0f0ce03fc09a},
	abstract = {As the infrastructure sector advances towards net-zero emissions, reducing embodied carbon in underground construction is essential, particularly for Tunnel Boring Machine (TBM) tunnelling. This paper introduces TunCO<inf>2</inf>, a digitalised framework that advances the practical integration of lifecycle carbon assessment with geotechnical design optimisation for TBM tunnelling. The framework extends prior carbon assessment models by incorporating the whole lifecycle of mechanised excavation as a quantifiable carbon source as TBM-specific adaptations in construction works. The proposed approach couples parametric modelling, carbon assessment, and geo-structural performance evaluation into a unified and repeatable methodology, enabling the explicit quantification of carbon–stability trade-offs in early design. Theoretical contributions include (i) the formalisation of a standardised carbon evaluation workflow directly compatible with geotechnical design practices, (ii) the introduction of a TBM lifecycle carbon module within parametric modelling, and (iii) a generalisable optimisation framework linking carbon intensity metrics to structural safety constraints. TunCO<inf>2</inf>′s implementation featuring automated 3D modelling of segmental linings, integrated carbon factor databases, and instant scenario visualisation, demonstrates how these concepts can support low-carbon decisions in early project setting. The carbon database interface, segmental lining modelling module, and exemplary carbon–stability optimisation scripts are released open source to encourage replication and further practical refinement. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Decarbonisation; Digitalisation; Embodied Carbon; Lifecycle Analysis; Tbm Tunnelling; Carbon; Carbon Cycle; Construction Equipment; Life Cycle; Life Cycle Assessment; Open Systems; Sustainable Development; Three Dimensional Computer Graphics; Tunneling (excavation); Tunneling Machines; Tunnels; Zero-carbon; Carbon Stability; Decarbonisation; Digitalization; Embodied Carbons; Geotechnical Designs; Life Cycle Analysis; Open-source; Parametric Models; Tunnel Boring; Tunnel Boring Machine Tunneling; Economic And Social Effects; Carbon Emission; Digitization; Life Cycle Analysis; Tbm; Tunnel Lining; Tunneling},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Asad2026207,
	author = {Asad, Ahmad and Capolupo, Alessandra and Tarantino, Eufemia},
